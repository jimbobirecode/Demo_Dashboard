# PostgreSQL connection. TLS for remote hosts is applied automatically (below).
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# TLS: every non-local host is reached over TLS whatever the URL says
# (server/src/lib/db-ssl.js). The certificate is verified when PGSSLROOTCERT
# names the provider's CA bundle (e.g. Supabase's), when the URL says
# sslmode=verify-full, or with DATABASE_SSL_VERIFY=true (system trust store);
# otherwise the connection is encrypted without verifying the certificate.
# PGSSLROOTCERT=/etc/ssl/certs/provider-ca.pem
# DATABASE_SSL_VERIFY=true
# Only for a private network that cannot offer TLS (logged at every start):
# DATABASE_SSL=disable

# Maximum connections in the server's pool. Default 10.
# PGPOOL_MAX=10

# The schema is applied by `npm run migrate`, and automatically at server start
# before it listens (db/migrations). Nothing to configure.

# Signing key for session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required in production — without it sessions drop on every restart.
JWT_SECRET=

# Name of the staff session cookie. Renaming it signs everybody out once.
# SESSION_COOKIE_NAME=teemail_session

PORT=3001
# development locally: production marks cookies Secure (https only), so sign-in
# would fail on http://localhost. Render sets NODE_ENV=production (render.yaml).
NODE_ENV=development

# ---------------------------------------------------------------------------
# Logging and error reporting
# ---------------------------------------------------------------------------
# json = one JSON object per line (for log drains); anything else = readable lines.
# LOG_FORMAT=json
# debug | info | warn | error. Default info.
# LOG_LEVEL=info
# Report server errors to Sentry. Off unless set; no request data or PII is sent.
# SENTRY_DSN=https://xxxx@oXXXX.ingest.sentry.io/XXXX
# Environment name shown in Sentry. Defaults to NODE_ENV.
# SENTRY_ENVIRONMENT=production
# (RENDER_GIT_COMMIT is set by Render itself and used as the Sentry release.)

# ---------------------------------------------------------------------------
# Sample data. SEED_ON_START=true fills an empty database at boot (hosts with
# no shell); =force rebuilds the sample rows. `npm run seed` does the same by hand.
# ---------------------------------------------------------------------------
# SEED_ON_START=false
# Club the sample rows belong to; defaults to the club existing users are on.
# (The SQL files in db/seeds fall back to the demo profile's club id, royal_dornoch.)
# SEED_CLUB=teemail
# Login the seed creates, and its password (otherwise a random one: `npm run seed`
# prints it; SEED_ON_START does not log it, so use "Forgot password" or set one).
# SEED_USERNAME=demo
# SEED_PASSWORD=

# ---------------------------------------------------------------------------
# Branding. Defaults to TeeMail Golf Club; set these to serve another club from
# the same deployment. The names below are what a guest sees on email and what
# the dashboard calls itself.
# ---------------------------------------------------------------------------
# CLUB_NAME=TeeMail
# CLUB_FULL_NAME=TeeMail Golf Club
# CLUB_ID=teemail
# Prefix of the booking references the dashboard issues (waitlist conversions,
# imported rows without one), as the core API's club profile uses: TMG for
# TeeMail Golf Club, RDG for the Royal Dornoch demo profile. Default TMG.
# BOOKING_REF_PREFIX=TMG
# CLUB_LOCALE=en-GB
# CLUB_CURRENCY=EUR
# CLUB_TIMEZONE=Europe/London
# DEFAULT_COURSE=Championship Course
#
# The browser half is read at BUILD time, so these belong wherever `npm run
# build` runs, not only in the server environment:
# VITE_CLUB_NAME=TeeMail
# VITE_CLUB_FULL_NAME=TeeMail Golf Club
# VITE_CLUB_TAGLINE=Visitor Bookings
# VITE_CLUB_LOGO=/logo.png
# VITE_CLUB_LOGO_ON_DARK=false

# ---------------------------------------------------------------------------
# Customer-journey email (Guest Emails page). Leave unset to hide the sending
# controls — the page still lists who is due.
# ---------------------------------------------------------------------------
# SENDGRID_API_KEY=SG.xxxxxxxx
# FROM_EMAIL=bookings@club.example.com
# FROM_NAME=TeeMail Golf Club
# Where guests' and operators' replies go. Defaults to FROM_EMAIL.
# REPLY_TO_EMAIL=bookings@club.example.com

# SendGrid dynamic template IDs (they start with "d-").
# SENDGRID_TEMPLATE_PRE_ARRIVAL=d-xxxxxxxx
# SENDGRID_TEMPLATE_POST_PLAY=d-xxxxxxxx

# How many days either side of the play date each campaign targets.
# PRE_ARRIVAL_DAYS=3
# POST_PLAY_DAYS=2

# ---------------------------------------------------------------------------
# Club Vero (feedback). Leave unset and the emails behave exactly as they did
# before the integration existed — they just go out without a survey link.
# ---------------------------------------------------------------------------
# Where Club Vero is served. No trailing slash needed.
# VERO_BASE_URL=https://clubvero.example.com
#
# The key Club Vero was given for this dashboard. It is set on the Vero side as
# PARTNER_INGEST_KEYS=dornoch:<this value>.
# VERO_PARTNER_KEY=sk_xxxxxxxxxxxx
#
# The partner name that key is registered under. Must match the name on the
# left of the colon in Vero's PARTNER_INGEST_KEYS.
# Default dornoch, a leftover of the Royal Dornoch demo profile.
# VERO_PARTNER_SOURCE=dornoch
#
# The club's slug in Vero. Only needed where one Vero deployment serves several
# clubs; a single-club Vero resolves it on its own.
# VERO_SITE=teemail-golf-club
#
# Which campaigns carry a survey link. Post-play only by default — a link in a
# welcome email asks somebody to rate a round they have not played yet.
# VERO_CAMPAIGNS=post_play

# ---------------------------------------------------------------------------
# Operator reminders (Operator Reminders page). The sender credentials above
# are shared — only the template IDs and the windows are set here. Leave unset
# to hide the sending controls; the page still lists which accounts are due.
# ---------------------------------------------------------------------------
# SendGrid dynamic template IDs for the two reminders sent to trade accounts.
# SENDGRID_TEMPLATE_OPERATOR_STATUS=d-xxxxxxxx
# SENDGRID_TEMPLATE_OPERATOR_PAYMENT=d-xxxxxxxx

# How far ahead each reminder looks. The status reminder covers play dates in
# the next N days; the payment reminder covers due dates in the next N days,
# plus everything already overdue however old.
# OPERATOR_STATUS_REMINDER_DAYS=21
# OPERATOR_PAYMENT_REMINDER_DAYS=7

# Where a reminder goes when an operator account has no contact address.
# Unset = such accounts are listed but cannot be sent to.
# OPERATOR_REMINDER_FALLBACK_EMAIL=accounts@club.example.com

# ---------------------------------------------------------------------------
# Password reset (the "Forgot your password?" link on the sign-in screen).
# The sender credentials above are shared. Without every value here the link
# is hidden rather than offered and left to fail.
# ---------------------------------------------------------------------------
# The dynamic template the reset email is rendered from. It must use
# {{reset_url}} (or {{reset_link}}); {{first_name}}, {{username}},
# {{club_name}} and {{expires_in}} are also passed.
# SENDGRID_TEMPLATE_PASSWORD_RESET=d-xxxxxxxx

# Where the dashboard is served, so the emailed link is absolute. No trailing
# slash needed. PUBLIC_URL is accepted as an alias.
# PUBLIC_URL=
# APP_URL=https://dashboard.club.example.com

# How long an emailed link stays usable. Default 60.
# PASSWORD_RESET_TTL_MINUTES=60

# ---------------------------------------------------------------------------
# Guests amending or cancelling their own booking. Links are signed with
# BOOKING_LINK_SECRET,
# or JWT_SECRET where that is not set — rotating either revokes every
# outstanding manage link at once.
# ---------------------------------------------------------------------------
# BOOKING_LINK_SECRET=

# Guests can only request a cancellation or a change; nothing takes effect until
# staff approve it on the Guest Requests page. (BOOKING_SELF_CANCEL_DAYS, which
# once let cancellations apply themselves, is no longer used.)

# ---------------------------------------------------------------------------
# User accounts (the Users page, administrators only). A new account is
# created with no password
# and emailed a one-time link, so this template is what a new colleague
# actually receives.
# ---------------------------------------------------------------------------
# It must use {{reset_url}} (or {{reset_link}}), the same as the reset
# template. It is also passed {{headline}}, {{invited_by}}, {{first_name}},
# {{username}}, {{club_name}} and {{expires_in}}.
# SENDGRID_TEMPLATE_USER_INVITE=d-xxxxxxxx

# How long an invitation stays usable. Longer than a reset by default, because
# it arrives unannounced and the reader may be away. Default 10080 (7 days).
# USER_INVITE_TTL_MINUTES=10080

# ---------------------------------------------------------------------------
# Card payment links (the "Card payment link" section of the booking drawer).
# Sending emails the guest a
# Stripe Payment Link and marks the booking's payment Pending; Stripe's webhook
# then marks it Paid (or Deposit paid for a part payment).
#
# In Stripe → Developers → Webhooks, add an endpoint:
#   URL:    https://<this dashboard>/api/stripe/webhook
#   Events: checkout.session.completed, checkout.session.async_payment_succeeded
#           (payment_intent.succeeded also works; a payment is counted once
#           whichever events are chosen)
# and paste its signing secret below. Test mode and live mode are separate in
# Stripe: each has its own endpoints AND its own signing secret, so the
# endpoint must be created in the same mode as STRIPE_SECRET_KEY. Open
# https://<this dashboard>/api/stripe/webhook in a browser to check the URL.
# Use sk_test_ keys to try it end to end.
# ---------------------------------------------------------------------------
# STRIPE_SECRET_KEY=sk_live_xxxxxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx

# How often (minutes) the dashboard asks Stripe about links still awaiting
# payment, so a payment lands even if the webhook never arrives. Default 2.
# APP_URL (below) is also used to check the webhook endpoint registered in Stripe.
# PAYMENT_SYNC_MINUTES=2

# Defaults to CLUB_CURRENCY (EUR).
# STRIPE_CURRENCY=EUR

# The payment link and receipt are the built-in TeeMail-branded emails. To use
# SendGrid templates instead, set both the template ids below and
# USE_SENDGRID_PAYMENT_TEMPLATES=true — the ids alone are ignored, because a
# template keeps whatever club name and logo it was written with.
# USE_SENDGRID_PAYMENT_TEMPLATES=false

# Optional. Without it a plain built-in email is sent. A template is passed
# {{payment_url}}, {{amount}}, {{first_name}}, {{guest_name}}, {{booking_id}},
# {{club_name}}, {{play_date}}, {{tee_time}}, {{course}}, {{players}} and
# {{booking_total}}. SENDGRID_API_KEY and FROM_EMAIL above are required either way.
# SENDGRID_TEMPLATE_PAYMENT_LINK=d-xxxxxxxx

# When Stripe reports a payment the guest is emailed a receipt straight away,
# the booking moves to Booked, and its pre-play clock starts. Optional; without
# it a plain built-in receipt is sent. A template is passed {{amount_received}},
# {{paid_on}}, {{payment_reference}}, {{booking_total}}, {{total_paid}},
# {{balance_due}}, {{paid_in_full}} and the booking fields listed above.
# SENDGRID_TEMPLATE_PAYMENT_RECEIPT=d-xxxxxxxx

# The pre-arrival welcome lists only bookings whose pre-play clock has started
# (a payment has been received). Set to false to list every Booked booking, as
# before — for a club that invoices after play.
# PRE_ARRIVAL_REQUIRES_PAYMENT=true

# ---------------------------------------------------------------------------
# Email branding. The payment link, the receipt and staff replies are sent in
# the same frame as the core API's guest emails: the logo on a white header
# with a teal rule, and the club's footer. The logo must be a public URL:
# EMAIL_LOGO_URL, or else this dashboard's own /logo.png under APP_URL. With
# neither, the header shows the club's name instead of a broken image.
# SendGrid templates (welcome, thank you, operator reminders, password reset,
# invitations) are passed the same values as {{logo_url}}, {{club_name}},
# {{brand_color}}, {{accent_color}}, {{club_email}}, {{club_phone}},
# {{club_address}} and {{club_website}} - use them in the template design.
# ---------------------------------------------------------------------------
# EMAIL_LOGO_URL=https://dashboard.example.com/logo.png
# CLUB_PHONE=+44 (0)1234 567890
# CLUB_ADDRESS=Links Road, Scotland
# CLUB_WEBSITE=https://teemail.io
# EMAIL_BRAND_COLOR=#1a5e58
# EMAIL_ACCENT_COLOR=#3a8030

# ---------------------------------------------------------------------------
# Tests only: a disposable Postgres for the DB integration tests
# (npm test skips them when unset). Never point this at real data.
# ---------------------------------------------------------------------------
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dashboard_test
